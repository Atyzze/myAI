# server.env -- optional runtime overrides. The generated systemd unit supplies
# safe defaults; uncomment only what you need. For managed installs, install.py's
# --bind/--port/--allow-plaintext choices are authoritative via VTS_* environment
# variables and cannot be accidentally overridden here. HOST/PORT/TLS_ENABLED
# remain useful when server.py is run manually.

# HOST=127.0.0.1
# PORT=4444
# DEVICE=cuda
# COMPUTE_TYPE=float16
# CPU_THREADS=0
# MODEL_WORKERS=1

# Request bodies are held in RAM and refused above this size.
# MAX_BODY_MB=8

# Speaker embeddings: auto | 1 | 0
# DIARIZE=auto
# EMBED_MIN_SEC=0.8
# Max padded audio (seconds) per speaker-embedding GPU pass. Peak embedding VRAM
# is roughly 0.5 GiB per 30 s; raising this trades VRAM for slightly fewer passes.
# EMBED_BATCH_SEC=30

# Keep source IP in the operational journal for abuse/rate-limit analysis.
# LOG_CLIENT_IP=1

# Only enable this behind a trusted proxy that overwrites X-Forwarded-For.
# TRUST_PROXY_HEADERS=0

# TLS behavior: 1 | 0
# TLS is REQUIRED by default, including on loopback. Setting 0 is an explicit
# opt-out for a trusted plaintext hop; managed installs use --allow-plaintext.
# TLS_ENABLED=1
# TLS_CERT=/absolute/path/fullchain.pem
# TLS_KEY=/absolute/path/privkey.pem

# Normally set by systemd. server.py refuses a non-tmpfs RAM_TMP_DIR.
# RAM_TMP_DIR=/dev/shm/vts
