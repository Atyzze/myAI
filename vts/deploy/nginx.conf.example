# Privacy-oriented reverse-proxy starting point for the transcription endpoint.
# Keep this limit aligned with MAX_BODY_MB in server.py.

location = /transcribe {
    client_max_body_size 8m;
    client_body_buffer_size 9m;

    # Stream request bytes to the application instead of buffering an upload to a
    # request-body temp file. HTTP/1.1 also avoids HTTP/1.0 chunked-body buffering.
    proxy_http_version 1.1;
    proxy_request_buffering off;

    # Transcript responses are sensitive too. Do not cache or spill them to a
    # proxy temp file.
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_no_cache 1;
    proxy_cache_bypass 1;

    proxy_set_header X-Forwarded-For $remote_addr;
    # VTS requires TLS by default. Trust/verify the VTS certificate according to
    # your deployment PKI; do not silently downgrade the backend hop to HTTP.
    proxy_pass https://127.0.0.1:4444/transcribe;

    add_header Cache-Control "no-store" always;
}

location = /healthz {
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_pass https://127.0.0.1:4444/healthz;
    add_header Cache-Control "no-store" always;
}
